# CampusArena / GDG_team — Render production environment
#
# Use this in one of two ways:
# 1. Paste each key/value into Render -> Environment
# 2. Upload this as a Render secret file named `.env` after replacing placeholders
#
# IMPORTANT:
# - Replace every <> placeholder before deploy
# - Do NOT set DB_ENGINE / DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT on Render
# - DATABASE_URL must be the Render Postgres internal connection string
# - REDIS_URL must be the Render Key Value / Redis internal connection string

DJANGO_SETTINGS_MODULE=gdgProject.settings.prod
DEBUG=False

# Generate a long random value in Render, or with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<replace-with-generated-secret-key>

# Your current Render hostname from the screenshot
ALLOWED_HOSTS=gdg-team.onrender.com
SITE_URL=https://gdg-team.onrender.com

# Render-managed Postgres internal connection string
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Render Key Value / Redis internal connection string
REDIS_URL=redis://default:<redis_password>@<redis_host>:6379

# Persistent uploads path if you mounted a Render disk at /var/data
MEDIA_ROOT=/var/data/media

# Logging
LOG_LEVEL=INFO

# Email
# For Gmail SMTP, use the same Gmail address for both DEFAULT_FROM_EMAIL and
# EMAIL_HOST_USER unless you have configured a verified alias in Gmail.
DEFAULT_FROM_EMAIL=yourgmailaddress@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=yourgmailaddress@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-google-app-password
EMAIL_TIMEOUT=10

# OAuth (leave blank if you are not using these yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payments (leave blank if you are not using Razorpay yet)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
